{
  "name": "stk_limit",
  "description": "每日涨跌停价格。接口：stk_limit 描述：数据开始于2007-01-04，获取全市场（包含A/B股和基金）每日涨跌停价格，包括涨停价格，跌停价格等，每个交易日9点左右更新当日股票涨跌停价格。 限量：单次最多提取5800条记录，可循环调取，总量不限制 积分：用户积2000积分可调取，单位分钟有流控，积分越高流量越大，请自行提高积分，具体请参阅 积分获取办法",
  "category": "股票行情",
  "source": "https://tushare.pro/document/2?doc_id=183",
  "verified_on": "2026-11-04",
  "permission": "points",
  "row_limit": 5800,
  "input_schema": {
    "type": "object",
    "properties": {
      "ts_code": {"type": "string", "description": "股票代码", "minLength": 1, "maxLength": 2000},
      "trade_date": {"type": "string", "description": "交易日期", "minLength": 1, "maxLength": 2000},
      "start_date": {"type": "string", "description": "开始日期", "minLength": 1, "maxLength": 2000},
      "end_date": {"type": "string", "description": "结束日期", "minLength": 1, "maxLength": 2000}
    },
    "required": [],
    "additionalProperties": false
  },
  "output_fields": [
    {"name": "trade_date", "type": "str", "description": "交易日期", "default": true},
    {"name": "ts_code", "type": "str", "description": "TS股票代码", "default": true},
    {"name": "pre_close", "type": "float", "description": "昨日收盘价", "default": false},
    {"name": "up_limit", "type": "float", "description": "涨停价", "default": true},
    {"name": "down_limit", "type": "float", "description": "跌停价", "default": true},
    {"name": "asset_type", "type": "str", "description": "类型 STK", "default": false},
    {"name": "exchange", "type": "str", "description": "交易所：SSE/SZSE/BSE", "default": false}
  ],
  "corrections": [],

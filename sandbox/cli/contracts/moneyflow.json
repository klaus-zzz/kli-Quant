{
  "name": "moneyflow",
  "description": "个股资金流向。接口：moneyflow，可以通过 数据工具 调试和查看数据。 描述：获取沪深A股票资金流向数据，分析大单小单成交情况，用于判别资金动向，数据开始于2010年。 限量：单次最大提取6000行记录，总量不限制 积分：用户需要至少2000积分才可以调取，基础积分有流量控制，积分越多权限越大，请自行提高积分，具体请参阅 积分获取办法",
  "category": "资金流",
  "source": "https://tushare.pro/document/2?doc_id=170",
  "verified_on": "2026-11-04",
  "permission": "points",
  "row_limit": 6000,
  "input_schema": {
    "type": "object",
    "properties": {
      "ts_code": {"type": "string", "description": "股票代码 （股票和时间参数至少输入一个）", "minLength": 1, "maxLength": 2000},
      "trade_date": {"type": "string", "description": "交易日期", "minLength": 1, "maxLength": 2000},
      "start_date": {"type": "string", "description": "开始日期", "minLength": 1, "maxLength": 2000},
      "end_date": {"type": "string", "description": "结束日期", "minLength": 1, "maxLength": 2000}
    },
    "required": [],
    "additionalProperties": false,
    "anyOf": [{"required": ["ts_code"]}, {"required": ["trade_date"]}, {"required": ["start_date"]}, {"required": ["end_date"]}]
  },
  "output_fields": [
    {"name": "ts_code", "type": "str", "description": "TS代码", "default": true},
    {"name": "trade_date", "type": "str", "description": "交易日期", "default": true},
    {"name": "buy_sm_vol", "type": "int", "description": "小单买入量（手）", "default": true},
    {"name": "buy_sm_amount", "type": "float", "description": "小单买入金额（万元）", "default": true},
    {"name": "sell_sm_vol", "type": "int", "description": "小单卖出量（手）", "default": true},
    {"name": "sell_sm_amount", "type": "float", "description": "小单卖出金额（万元）", "default": true},
    {"name": "buy_md_vol", "type": "int", "description": "中单买入量（手）", "default": true},
    {"name": "buy_md_amount", "type": "float", "description": "中单买入金额（万元）", "default": true},
    {"name": "sell_md_vol", "type": "int", "description": "中单卖出量（手）", "default": true},
    {"name": "sell_md_amount", "type": "float", "description": "中单卖出金额（万元）", "default": true},
    {"name": "buy_lg_vol", "type": "int", "description": "大单买入量（手）", "default": true},
    {"name": "buy_lg_amount", "type": "float", "description": "大单买入金额（万元）", "default": true},
    {"name": "sell_lg_vol", "type": "int", "description": "大单卖出量（手）", "default": true},
    {"name": "sell_lg_amount", "type": "float", "description": "大单卖出金额（万元）", "default": true},
    {"name": "buy_elg_vol", "type": "int", "description": "特大单买入量（手）", "default": true},
    {"name": "buy_elg_amount", "type": "float", "description": "特大单买入金额（万元）", "default": true},
    {"name": "sell_elg_vol", "type": "int", "description": "特大单卖出量（手）", "default": true},
    {"name": "sell_elg_amount", "type": "float", "description": "特大单卖出金额（万元）", "default": true},
    {"name": "net_mf_vol", "type": "int", "description": "净流入量（手）", "default": true},
    {"name": "net_mf_amount", "type": "float", "description": "净流入额（万元）", "default": true}
  ],
  "corrections": ["条件必填：ts_code、trade_date、start_date、end_date 至少提供一个；优先遵循正文条件说明"],
  "units": "字段描述中的单位保留原样；未注明的单位不作推断。"
}

    {"name": "bid_pct_chg", "type": "float", "description": "竞价涨幅%", "default": true},
    {"name": "rt_pct_chg", "type": "float", "description": "实时涨幅%", "default": true},
    {"name": "limit_order", "type": "float", "description": "封单", "default": true},

  "permission": "points",
  "row_limit": 1000,
  "input_schema": {
    "type": "object",
    "properties": {
      "ts_code": {"type": "string", "description": "TS代码", "minLength": 1, "maxLength": 2000},
      "trade_date": {"type": "string", "description": "交易日期", "minLength": 1, "maxLength": 2000},
      "start_date": {"type": "string", "description": "开始日期", "minLength": 1, "maxLength": 2000},
      "end_date": {"type": "string", "description": "结束日期", "minLength": 1, "maxLength": 2000}

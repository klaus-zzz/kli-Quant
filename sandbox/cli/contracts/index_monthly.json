    {"name": "change", "type": "float", "description": "涨跌点位", "default": true},
    {"name": "pct_chg", "type": "float", "description": "涨跌幅", "default": true},
    {"name": "vol", "type": "float", "description": "成交量（手）", "default": true},
    {"name": "amount", "type": "float", "description": "成交额（千元）", "default": true}

{
  "name": "cb_share",
  "description": "可转债转股结果。接口：cb_share 描述：获取可转债转股结果 限量：单次最大2000，总量不限制 权限：用户需要至少2000积分才可以调取，但有流量控制，5000积分以上频次相对较高，积分越多权限越大，具体请参阅 积分获取办法",
  "category": "债券与日历",
  "source": "https://tushare.pro/document/2?doc_id=247",
  "verified_on": "2026-11-04",
  "permission": "points",
  "row_limit": null,
  "input_schema": {
    "type": "object",

    {"name": "convert_val", "type": "float", "description": "本次转股金额", "default": true},
    {"name": "convert_vol", "type": "float", "description": "本次转股数量", "default": true},
    {"name": "convert_ratio", "type": "float", "description": "本次转股比例", "default": true},

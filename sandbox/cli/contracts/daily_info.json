{
  "name": "daily_info",
  "description": "市场交易统计。接口：daily_info 描述：获取交易所股票交易统计，包括各板块明细 限量：单次最大4000，可循环获取，总量不限制 权限：用户积600积分可调取， 频次有限制，积分越高每分钟调取频次越高，5000积分以上频次相对较高，积分获取方法请参阅 积分获取办法",
  "category": "指数统计",
  "source": "https://tushare.pro/document/2?doc_id=215",
  "verified_on": "2026-11-04",
  "permission": "points",
  "row_limit": null,
  "input_schema": {
    "type": "object",
    "properties": {
      "trade_date": {"type": "string", "description": "交易日期（YYYYMMDD格式，下同）", "minLength": 1, "maxLength": 2000},
      "ts_code": {"type": "string", "description": "板块代码（请参阅下方列表）", "minLength": 1, "maxLength": 2000},
      "exchange": {"type": "string", "description": "股票市场（SH上交所 SZ深交所）", "minLength": 1, "maxLength": 2000},
      "start_date": {"type": "string", "description": "开始日期", "minLength": 1, "maxLength": 2000},
      "end_date": {"type": "string", "description": "结束日期", "minLength": 1, "maxLength": 2000}
    },
    "required": [],
    "additionalProperties": false
  },
  "output_fields": [
    {"name": "trade_date", "type": "str", "description": "交易日期", "default": true},
    {"name": "ts_code", "type": "str", "description": "市场代码", "default": true},
    {"name": "ts_name", "type": "str", "description": "市场名称", "default": true},
    {"name": "com_count", "type": "int", "description": "挂牌数", "default": true},
    {"name": "total_share", "type": "float", "description": "总股本（亿股）", "default": true},
    {"name": "float_share", "type": "float", "description": "流通股本（亿股）", "default": true},
    {"name": "total_mv", "type": "float", "description": "总市值（亿元）", "default": true},
    {"name": "float_mv", "type": "float", "description": "流通市值（亿元）", "default": true},
    {"name": "amount", "type": "float", "description": "交易金额（亿元）", "default": true},
    {"name": "vol", "type": "float", "description": "成交量（亿股）", "default": true},
    {"name": "trans_count", "type": "int", "description": "成交笔数（万笔）", "default": true},
    {"name": "pe", "type": "float", "description": "平均市盈率", "default": true},
    {"name": "tr", "type": "float", "description": "换手率（％），注：深交所暂无此列", "default": true},
    {"name": "exchange", "type": "str", "description": "交易所（SH上交所 SZ深交所）", "default": true}
  ],
  "corrections": ["fields 为官方 HTTP 协议顶层字段选择，统一从 params 移到工具 fields 参数"],
  "units": "字段描述中的单位保留原样；未注明的单位不作推断。"
}

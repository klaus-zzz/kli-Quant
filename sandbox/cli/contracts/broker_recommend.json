{
  "name": "broker_recommend",
  "description": "券商每月荐股。接口：broker_recommend 描述：获取券商月度金股，一般1日~3日内更新当月数据 限量：单次最大1000行数据，可循环提取 积分：积分达到6000即可调用，具体请参阅 积分获取办法",
  "category": "特色数据",
  "source": "https://tushare.pro/document/2?doc_id=267",
  "verified_on": "2026-11-04",
  "permission": "points",
  "row_limit": 1000,
  "input_schema": {
    "type": "object",
    "properties": {
      "month": {"type": "string", "description": "月度（YYYYMM）", "minLength": 1, "maxLength": 2000}
    },
    "required": ["month"],
    "additionalProperties": false
  },
  "output_fields": [
    {"name": "month", "type": "str", "description": "月度", "default": true},
    {"name": "broker", "type": "str", "description": "券商", "default": true},
    {"name": "ts_code", "type": "str", "description": "股票代码", "default": true},
    {"name": "name", "type": "str", "description": "股票简称", "default": true}
  ],
  "corrections": [],
  "units": "字段描述中的单位保留原样；未注明的单位不作推断。"
}

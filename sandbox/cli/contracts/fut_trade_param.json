  "category": "期货",
  "source": "https://tushare.pro/document/2?doc_id=497",
  "verified_on": "2026-11-04",
  "permission": "points",
  "row_limit": 3000,
  "input_schema": {
    "type": "object",
    "properties": {
      "ts_code": {"type": "string", "description": "期货代码", "minLength": 1, "maxLength": 2000},
      "trade_date": {"type": "string", "description": "交易日期（YYYYMMDD）", "minLength": 1, "maxLength": 2000},
      "start_date": {"type": "string", "description": "开始日期（YYYYMMDD）", "minLength": 1, "maxLength": 2000},
      "end_date": {"type": "string", "description": "结束日期（YYYYMMDD）", "minLength": 1, "maxLength": 2000}
    },
    "required": [],
    "additionalProperties": false
  },
  "output_fields": [
    {"name": "ts_code", "type": "str", "description": "合约代码或类型", "default": true},
    {"name": "trade_date", "type": "str", "description": "交易日期（YYYYMMDD）", "default": true},
    {"name": "exchange", "type": "str", "description": "期货公司会员简称", "default": true},
    {"name": "trade_unit", "type": "str", "description": "交易单位", "default": true},
    {"name": "tick_size", "type": "str", "description": "最小变动价位", "default": true},
    {"name": "pre_settle_price", "type": "str", "description": "上日结算价", "default": true},
    {"name": "price_limit", "type": "str", "description": "涨跌停板幅度(%)", "default": true},
    {"name": "position_limit", "type": "str", "description": "日持仓限额", "default": true},
    {"name": "trade_limit", "type": "str", "description": "交易限额", "default": true},
    {"name": "min_order_qty", "type": "str", "description": "最小开仓量下单量", "default": true},
    {"name": "max_limit_order_qty", "type": "str", "description": "限价单最大下单量", "default": true},
    {"name": "max_market_order_qty", "type": "str", "description": "市价单最大下单量", "default": true}

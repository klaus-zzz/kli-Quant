      "trade_date": {"type": "string", "description": "交易日期：（YYYYMMDD格式）", "minLength": 1, "maxLength": 2000},
      "start_date": {"type": "string", "description": "开始日期：（YYYYMMDD格式）", "minLength": 1, "maxLength": 2000},
      "end_date": {"type": "string", "description": "结束日期：（YYYYMMDD格式）", "minLength": 1, "maxLength": 2000}

  "output_fields": [
    {"name": "ts_code", "type": "str", "description": "板块代码", "default": true},
    {"name": "trade_date", "type": "str", "description": "交易日期", "default": true},
    {"name": "con_code", "type": "str", "description": "成分股票代码", "default": true},
    {"name": "con_name", "type": "str", "description": "成分股票名称", "default": true}
  ],
  "corrections": [],

{
  "name": "report_rc",
  "description": "卖方盈利预测数据。接口：report_rc 描述：获取券商（卖方）每天研报的盈利预测数据，数据从2010年开始，交易日当天的数据会更新2次，第一次是在21点15更新一次，第二次是在次日9点15更新一次。 限量：单次最大3000条，可分页和循环提取所有数据 权限：本接口2000积分可以试用，每天10次请求，正式权限需8000积分，每天可请求100000次，10000积分以上无总量限制。",
  "category": "特色数据",
  "source": "https://tushare.pro/document/2?doc_id=292",
  "verified_on": "2026-11-04",
  "permission": "points",
  "row_limit": 3000,
  "input_schema": {
    "type": "object",
    "properties": {
      "ts_code": {"type": "string", "description": "股票代码", "minLength": 1, "maxLength": 2000},
      "report_date": {"type": "string", "description": "报告日期", "minLength": 1, "maxLength": 2000},
      "start_date": {"type": "string", "description": "报告开始日期", "minLength": 1, "maxLength": 2000},
      "end_date": {"type": "string", "description": "报告结束日期", "minLength": 1, "maxLength": 2000}
    },
    "required": [],
    "additionalProperties": false
  },

      "freq": {"type": "string", "description": "频率(日daily)", "minLength": 1, "maxLength": 2000},
      "start_date": {"type": "string", "description": "开始时间", "minLength": 1, "maxLength": 2000},
      "end_date": {"type": "string", "description": "结束时间", "minLength": 1, "maxLength": 2000}
    },
    "required": [],

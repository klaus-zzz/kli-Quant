{
  "name": "etf_share_size",
  "description": "ETF份额规模。接口：etf_share_size 描述：获取沪深ETF每日份额和规模数据，能体现规模份额的变化，掌握ETF资金动向，同时提供每日净值和收盘价；数据指标是分批入库，交易所于次日早8点30左右更新上一交易日的数据；另外，涉及海外的ETF数据更新会晚一些属于正常情况。 限量：单次最大5000条，可根据代码或日期循环提取 积分：需要8000积分可以调取，具体请参阅 积分获取办法",
  "category": "ETF",
  "source": "https://tushare.pro/document/2?doc_id=408",
  "verified_on": "2026-11-04",
  "permission": "points",
  "row_limit": 5000,
  "input_schema": {
    "type": "object",
    "properties": {
      "ts_code": {"type": "string", "description": "基金代码 （可从ETF基础信息接口提取）", "minLength": 1, "maxLength": 2000},
      "trade_date": {"type": "string", "description": "交易日期（YYYYMMDD格式，下同）", "minLength": 1, "maxLength": 2000},
      "start_date": {"type": "string", "description": "开始日期", "minLength": 1, "maxLength": 2000},
      "end_date": {"type": "string", "description": "结束日期", "minLength": 1, "maxLength": 2000},
      "exchange": {"type": "string", "description": "交易所（SSE上交所 SZSE深交所）", "minLength": 1, "maxLength": 2000}
    },
    "required": [],
    "additionalProperties": false
  },
  "output_fields": [
    {"name": "trade_date", "type": "str", "description": "交易日期", "default": true},
    {"name": "ts_code", "type": "str", "description": "ETF代码", "default": true},
    {"name": "etf_name", "type": "str", "description": "基金名称", "default": true},
    {"name": "total_share", "type": "float", "description": "总份额（万份）", "default": true},
    {"name": "total_size", "type": "float", "description": "总规模（万元）", "default": true},
    {"name": "nav", "type": "float", "description": "基金份额净值(元)", "default": false},
    {"name": "close", "type": "float", "description": "收盘价（元）", "default": false},
    {"name": "exchange", "type": "str", "description": "交易所（SSE上交所 SZSE深交所 BSE北交所）", "default": true}
  ],
  "corrections": [],
  "units": "字段描述中的单位保留原样；未注明的单位不作推断。"
}

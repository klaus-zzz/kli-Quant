  "permission": "points",
  "row_limit": 5000,
  "input_schema": {
    "type": "object",
    "properties": {
      "m": {"type": "string", "description": "月份（YYYYMM，下同），支持多个月份同时输入，逗号分隔", "minLength": 1, "maxLength": 2000},
      "start_m": {"type": "string", "description": "开始月份", "minLength": 1, "maxLength": 2000},
      "end_m": {"type": "string", "description": "结束月份", "minLength": 1, "maxLength": 2000}
    },
    "required": [],
    "additionalProperties": false
  },
  "output_fields": [

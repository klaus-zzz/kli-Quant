    {"name": "nt_mom", "type": "float", "description": "全国环比（%）", "default": true},
    {"name": "nt_accu", "type": "float", "description": "全国累计值", "default": true},
    {"name": "town_val", "type": "float", "description": "城市当月值", "default": true},
    {"name": "town_yoy", "type": "float", "description": "城市同比（%）", "default": true},
    {"name": "town_mom", "type": "float", "description": "城市环比（%）", "default": true},
    {"name": "town_accu", "type": "float", "description": "城市累计值", "default": true},
    {"name": "cnt_val", "type": "float", "description": "农村当月值", "default": true},
    {"name": "cnt_yoy", "type": "float", "description": "农村同比（%）", "default": true},

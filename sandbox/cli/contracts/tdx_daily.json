{
  "name": "tdx_daily",
  "description": "TDX板块行情。接口：tdx_daily 描述：获取各板块行情，包括成交和估值等数据 限量：单次提取最大3000条数据，可根据板块代码和日期参数循环提取 权限：用户积累6000积分可调取，具体请参阅 积分获取办法",
  "category": "板块榜单",
  "source": "https://tushare.pro/document/2?doc_id=378",
  "verified_on": "2026-11-04",
  "permission": "points",
  "row_limit": 3000,
  "input_schema": {
    "type": "object",
    "properties": {
      "ts_code": {"type": "string", "description": "板块代码：xxxxxx.TDX", "minLength": 1, "maxLength": 2000},
      "trade_date": {"type": "string", "description": "交易日期，格式YYYYMMDD,下同", "minLength": 1, "maxLength": 2000},
      "start_date": {"type": "string", "description": "开始日期", "minLength": 1, "maxLength": 2000},
      "end_date": {"type": "string", "description": "结束日期", "minLength": 1, "maxLength": 2000}
    },
    "required": [],
    "additionalProperties": false
  },
  "output_fields": [
    {"name": "ts_code", "type": "str", "description": "板块代码", "default": true},
    {"name": "trade_date", "type": "str", "description": "交易日期", "default": true},
    {"name": "close", "type": "float", "description": "收盘点位", "default": true},
    {"name": "open", "type": "float", "description": "开盘点位", "default": true},
    {"name": "high", "type": "float", "description": "最高点位", "default": true},
    {"name": "low", "type": "float", "description": "最低点位", "default": true},
    {"name": "pre_close", "type": "float", "description": "昨日收盘点", "default": true},
    {"name": "change", "type": "float", "description": "涨跌点位", "default": true},
    {"name": "pct_change", "type": "float", "description": "涨跌幅%", "default": true},
    {"name": "vol", "type": "float", "description": "成交量（手）", "default": true},
    {"name": "amount", "type": "float", "description": "成交额（万元）, 对于期货指数，该字段存储持仓量", "default": true},
    {"name": "rise", "type": "str", "description": "收盘涨速%", "default": true},
    {"name": "vol_ratio", "type": "float", "description": "量比", "default": true},
    {"name": "turnover_rate", "type": "float", "description": "换手%", "default": true},
    {"name": "swing", "type": "float", "description": "振幅%", "default": true},
    {"name": "up_num", "type": "int", "description": "上涨家数", "default": true},
    {"name": "down_num", "type": "int", "description": "下跌家数", "default": true},
    {"name": "limit_up_num", "type": "int", "description": "涨停家数", "default": true},
    {"name": "limit_down_num", "type": "int", "description": "跌停家数", "default": true},
    {"name": "lu_days", "type": "int", "description": "连涨天数", "default": true},
    {"name": "3day", "type": "float", "description": "3日涨幅%", "default": true},
    {"name": "5day", "type": "float", "description": "5日涨幅%", "default": true},
    {"name": "10day", "type": "float", "description": "10日涨幅%", "default": true},
    {"name": "20day", "type": "float", "description": "20日涨幅%", "default": true},
    {"name": "60day", "type": "float", "description": "60日涨幅%", "default": true},
    {"name": "mtd", "type": "float", "description": "月初至今%", "default": true},
    {"name": "ytd", "type": "float", "description": "年初至今%", "default": true},
    {"name": "1year", "type": "float", "description": "一年涨幅%", "default": true},
    {"name": "pe", "type": "str", "description": "市盈率", "default": true},
    {"name": "pb", "type": "str", "description": "市净率", "default": true},
    {"name": "float_mv", "type": "float", "description": "流通市值(亿)", "default": true},
    {"name": "ab_total_mv", "type": "float", "description": "AB股总市值（亿）", "default": true},
    {"name": "float_share", "type": "float", "description": "流通股(亿)", "default": true},
    {"name": "total_share", "type": "float", "description": "总股本(亿)", "default": true},
    {"name": "bm_buy_net", "type": "float", "description": "主买净额(元)", "default": true},
    {"name": "bm_buy_ratio", "type": "float", "description": "主买占比%", "default": true},
    {"name": "bm_net", "type": "float", "description": "主力净额", "default": true},
    {"name": "bm_ratio", "type": "float", "description": "主力占比%", "default": true}
  ],
  "corrections": [],
  "units": "字段描述中的单位保留原样；未注明的单位不作推断。"
}

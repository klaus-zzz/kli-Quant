{
  "name": "express",
  "description": "业绩快报。接口：express 描述：获取上市公司业绩快报 权限：用户需要至少2000积分才可以调取，具体请参阅 积分获取办法 提示：当前接口只能按单只股票获取其历史数据，如果需要获取某一季度全部上市公司数据，请使用express_vip接口（参数一致），需积攒5000积分。",
  "category": "财务",
  "source": "https://tushare.pro/document/2?doc_id=46",
  "verified_on": "2026-11-04",
  "permission": "points",
  "row_limit": null,
  "input_schema": {
    "type": "object",
    "properties": {
      "ts_code": {"type": "string", "description": "股票代码", "minLength": 1, "maxLength": 2000},
      "ann_date": {"type": "string", "description": "公告日期", "minLength": 1, "maxLength": 2000},
      "start_date": {"type": "string", "description": "公告开始日期", "minLength": 1, "maxLength": 2000},
      "end_date": {"type": "string", "description": "公告结束日期", "minLength": 1, "maxLength": 2000},
      "period": {"type": "string", "description": "报告期(每个季度最后一天的日期,比如20171231表示年报，20170630半年报，20170930三季报)", "minLength": 1, "maxLength": 2000}
    },
    "required": ["ts_code"],
    "additionalProperties": false
  },
  "output_fields": [
    {"name": "ts_code", "type": "str", "description": "TS股票代码", "default": true},
    {"name": "ann_date", "type": "str", "description": "公告日期", "default": true},
    {"name": "end_date", "type": "str", "description": "报告期", "default": true},
    {"name": "revenue", "type": "float", "description": "营业收入(元)", "default": true},
    {"name": "operate_profit", "type": "float", "description": "营业利润(元)", "default": true},
    {"name": "total_profit", "type": "float", "description": "利润总额(元)", "default": true},
    {"name": "n_income", "type": "float", "description": "净利润(元)", "default": true},
    {"name": "total_assets", "type": "float", "description": "总资产(元)", "default": true},
    {"name": "total_hldr_eqy_exc_min_int", "type": "float", "description": "股东权益合计(不含少数股东权益)(元)", "default": true},
    {"name": "diluted_eps", "type": "float", "description": "每股收益(摊薄)(元)", "default": true},
    {"name": "diluted_roe", "type": "float", "description": "净资产收益率(摊薄)(%)", "default": true},
    {"name": "yoy_net_profit", "type": "float", "description": "去年同期修正后净利润", "default": true},
    {"name": "bps", "type": "float", "description": "每股净资产", "default": true},
    {"name": "yoy_sales", "type": "float", "description": "同比增长率:营业收入", "default": false},
    {"name": "yoy_op", "type": "float", "description": "同比增长率:营业利润", "default": false},
    {"name": "yoy_tp", "type": "float", "description": "同比增长率:利润总额", "default": false},
    {"name": "yoy_dedu_np", "type": "float", "description": "同比增长率:归属母公司股东的净利润", "default": false},
    {"name": "yoy_eps", "type": "float", "description": "同比增长率:基本每股收益", "default": false},
    {"name": "yoy_roe", "type": "float", "description": "同比增减:加权平均净资产收益率", "default": false},
    {"name": "growth_assets", "type": "float", "description": "比年初增长率:总资产", "default": false},
    {"name": "yoy_equity", "type": "float", "description": "比年初增长率:归属母公司的股东权益", "default": false},
    {"name": "growth_bps", "type": "float", "description": "比年初增长率:归属于母公司股东的每股净资产", "default": false},
    {"name": "or_last_year", "type": "float", "description": "去年同期营业收入", "default": false},
    {"name": "op_last_year", "type": "float", "description": "去年同期营业利润", "default": false},
    {"name": "tp_last_year", "type": "float", "description": "去年同期利润总额", "default": false},
    {"name": "np_last_year", "type": "float", "description": "去年同期净利润", "default": false},
    {"name": "eps_last_year", "type": "float", "description": "去年同期每股收益", "default": false},
    {"name": "open_net_assets", "type": "float", "description": "期初净资产", "default": false},
    {"name": "open_bps", "type": "float", "description": "期初每股净资产", "default": false},
    {"name": "perf_summary", "type": "str", "description": "业绩简要说明", "default": false},
    {"name": "is_audit", "type": "int", "description": "是否审计： 1是 0否", "default": false},
    {"name": "remark", "type": "str", "description": "备注", "default": false}
  ],
  "corrections": [],
  "units": "字段描述中的单位保留原样；未注明的单位不作推断。"
}

{
  "name": "stock_basic",
  "description": "股票基础信息。接口：stock_basic，可以通过 数据工具 调试和查看数据 描述：获取基础信息数据，包括股票代码、名称、上市日期、退市日期等 限量：每次最多返回6000行数据（覆盖全市场A股，会随股票总数增长而增加） 权限：2000积分起，每分钟请求50次。此接口是基础信息，调取一次就可以拉取完，建议保存倒本地存储后使用",
  "category": "股票基础",
  "source": "https://tushare.pro/document/2?doc_id=25",
  "verified_on": "2026-11-04",
  "permission": "points",
  "row_limit": 6000,
  "input_schema": {
    "type": "object",
    "properties": {
      "ts_code": {"type": "string", "description": "TS股票代码( 格式说明 )", "minLength": 1, "maxLength": 2000},
      "name": {"type": "string", "description": "名称", "minLength": 1, "maxLength": 2000},
      "market": {"type": "string", "description": "市场类别 （主板/创业板/科创板/CDR/北交所）", "minLength": 1, "maxLength": 2000},
      "list_status": {"type": "string", "description": "上市状态 L上市 D退市 P暂停上市 G 未交易 UN未上市，默认是L", "minLength": 1, "maxLength": 2000},
      "exchange": {"type": "string", "description": "交易所 SSE上交所 SZSE深交所 BSE北交所", "minLength": 1, "maxLength": 2000},
      "is_hs": {"type": "string", "description": "是否沪深港通标的，N否 H沪股通 S深股通", "minLength": 1, "maxLength": 2000}
    },
    "required": [],
    "additionalProperties": false
  },
  "output_fields": [
    {"name": "ts_code", "type": "str", "description": "TS代码", "default": true},
    {"name": "symbol", "type": "str", "description": "股票代码", "default": true},
    {"name": "name", "type": "str", "description": "股票名称", "default": true},
    {"name": "area", "type": "str", "description": "地域", "default": true},
    {"name": "industry", "type": "str", "description": "所属行业", "default": true},

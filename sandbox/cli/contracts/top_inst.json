    {"name": "sell", "type": "float", "description": "卖出额（元）", "default": true},
    {"name": "sell_rate", "type": "float", "description": "卖出占总成交比例", "default": true},
    {"name": "net_buy", "type": "float", "description": "净成交额（元）", "default": true},
    {"name": "reason", "type": "str", "description": "上榜理由", "default": true}

{
  "name": "dc_hot",
  "description": "DC热榜。接口：dc_hot 描述：获取热榜数据，包括A股市场、ETF基金、港股市场、美股市场等等，每日盘中提取4次，收盘后4次，最晚22点提取一次。 限量：单次最大2000条，可根据日期等参数循环获取全部数据 积分：用户积8000积分可调取使用，积分获取办法请参阅 积分获取办法",
  "category": "板块榜单",
  "source": "https://tushare.pro/document/2?doc_id=321",
  "verified_on": "2026-11-04",
  "permission": "points",
  "row_limit": 2000,
  "input_schema": {
    "type": "object",
    "properties": {
      "trade_date": {"type": "string", "description": "交易日期", "minLength": 1, "maxLength": 2000},
      "ts_code": {"type": "string", "description": "TS代码", "minLength": 1, "maxLength": 2000},
      "market": {"type": "string", "description": "类型(A股市场、ETF基金、港股市场、美股市场)", "minLength": 1, "maxLength": 2000},
      "hot_type": {"type": "string", "description": "热点类型(人气榜、飙升榜)", "minLength": 1, "maxLength": 2000},
      "is_new": {"type": "string", "description": "是否最新（默认Y，如果为N则为盘中和盘后阶段采集，具体时间可参考rank_time字段，状态N每2小时更新一次，状态Y更新时间为22：30）", "minLength": 1, "maxLength": 2000}
    },
    "required": [],
    "additionalProperties": false
  },
  "output_fields": [
    {"name": "trade_date", "type": "str", "description": "交易日期", "default": true},
    {"name": "data_type", "type": "str", "description": "数据类型", "default": true},
    {"name": "ts_code", "type": "str", "description": "股票代码", "default": true},
    {"name": "ts_name", "type": "str", "description": "股票名称", "default": true},
    {"name": "rank", "type": "int", "description": "排行或者热度", "default": true},
    {"name": "pct_change", "type": "float", "description": "涨跌幅%", "default": true},
    {"name": "current_price", "type": "float", "description": "当前价", "default": true},
    {"name": "rank_time", "type": "str", "description": "排行榜获取时间", "default": true}
  ],

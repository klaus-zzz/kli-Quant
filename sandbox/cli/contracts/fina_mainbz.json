{
  "name": "fina_mainbz",
  "description": "主营业务构成。接口：fina_mainbz 描述：获得上市公司主营业务构成，分地区/产品/行业等方式。 权限：用户需要至少2000积分才可以调取，具体请参阅 积分获取办法 ，单次最大提取100行，总量不限制，可循环获取。 提示：当前接口只能按单只股票获取其历史数据，如果需要获取某一季度全部上市公司数据，请使用fina_mainbz_vip接口（参数一致），需积攒5000积分。",
  "category": "财务",
  "source": "https://tushare.pro/document/2?doc_id=81",
  "verified_on": "2026-11-04",
  "permission": "points",
  "row_limit": 100,
  "input_schema": {
    "type": "object",
    "properties": {
      "ts_code": {"type": "string", "description": "股票代码", "minLength": 1, "maxLength": 2000},
      "period": {"type": "string", "description": "报告期(每个季度最后一天的日期,比如20171231表示年报)", "minLength": 1, "maxLength": 2000},
      "type": {"type": "string", "description": "类型：P-按产品 D-按地区 I-按行业 S-销售模式（请输入大写字母）", "minLength": 1, "maxLength": 2000},
      "start_date": {"type": "string", "description": "报告期开始日期", "minLength": 1, "maxLength": 2000},
      "end_date": {"type": "string", "description": "报告期结束日期", "minLength": 1, "maxLength": 2000}
    },
    "required": ["ts_code"],
    "additionalProperties": false
  },
  "output_fields": [
    {"name": "ts_code", "type": "str", "description": "TS代码", "default": true},
    {"name": "end_date", "type": "str", "description": "报告期", "default": true},
    {"name": "bz_item", "type": "str", "description": "主营业务来源", "default": true},
    {"name": "bz_code", "type": "str", "description": "主营业务来源类型（P-按产品 D-按地区 I-按行业）", "default": true},
    {"name": "bz_sales", "type": "float", "description": "主营业务收入(元)", "default": true},
    {"name": "bz_profit", "type": "float", "description": "主营业务利润(元)", "default": true},
    {"name": "bz_cost", "type": "float", "description": "主营业务成本(元)", "default": true},
    {"name": "curr_type", "type": "str", "description": "货币代码（CNY）", "default": true},
    {"name": "update_flag", "type": "str", "description": "是否更新", "default": true}
  ],
  "corrections": [],
  "units": "字段描述中的单位保留原样；未注明的单位不作推断。"
}

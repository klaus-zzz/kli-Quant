{
  "name": "income_vip",
  "description": "利润表。接口：income，可以通过 数据工具 调试和查看数据。 描述：获取上市公司财务利润表数据 积分：用户需要至少2000积分才可以调取，具体请参阅 积分获取办法 提示：当前接口只能按单只股票获取其历史数据，如果需要获取某一季度全部上市公司数据，请使用income_vip接口（参数一致），需积攒5000积分。",
  "category": "财务",
  "source": "https://tushare.pro/document/2?doc_id=33",
  "verified_on": "2026-11-04",
  "permission": "points",
  "row_limit": null,
  "input_schema": {
    "type": "object",
    "properties": {
      "ts_code": {"type": "string", "description": "股票代码", "minLength": 1, "maxLength": 2000},
      "ann_date": {"type": "string", "description": "公告日期（YYYYMMDD格式，下同）", "minLength": 1, "maxLength": 2000},
      "f_ann_date": {"type": "string", "description": "实际公告日期", "minLength": 1, "maxLength": 2000},
      "start_date": {"type": "string", "description": "公告日开始日期", "minLength": 1, "maxLength": 2000},
      "end_date": {"type": "string", "description": "公告日结束日期", "minLength": 1, "maxLength": 2000},
      "period": {"type": "string", "description": "报告期(每个季度最后一天的日期，比如20171231表示年报，20170630半年报，20170930三季报)", "minLength": 1, "maxLength": 2000},
      "report_type": {"type": "string", "description": "报告类型，参考文档最下方说明", "minLength": 1, "maxLength": 2000},
      "comp_type": {"type": "string", "description": "公司类型（1一般工商业2银行3保险4证券7多元金融）", "minLength": 1, "maxLength": 2000}

{
  "name": "tdx_index",
  "description": "TDX板块信息。接口：tdx_index 描述：获取板块基础信息，包括概念板块、行业、风格、地域等 限量：单次最大1000条数据，可根据日期参数循环提取 权限：用户积累6000积分可调取，具体请参阅 积分获取办法",
  "category": "板块榜单",
  "source": "https://tushare.pro/document/2?doc_id=376",
  "verified_on": "2026-11-04",
  "permission": "points",
  "row_limit": 1000,
  "input_schema": {
    "type": "object",
    "properties": {
      "ts_code": {"type": "string", "description": "板块代码：xxxxxx.TDX", "minLength": 1, "maxLength": 2000},
      "trade_date": {"type": "string", "description": "交易日期(格式：YYYYMMDD）", "minLength": 1, "maxLength": 2000},
      "idx_type": {"type": "string", "description": "板块类型：概念板块、行业板块、风格板块、地区板块", "minLength": 1, "maxLength": 2000}
    },
    "required": [],
    "additionalProperties": false
  },
  "output_fields": [
    {"name": "ts_code", "type": "str", "description": "板块代码", "default": true},
    {"name": "trade_date", "type": "str", "description": "交易日期", "default": true},
    {"name": "name", "type": "str", "description": "板块名称", "default": true},
    {"name": "idx_type", "type": "str", "description": "板块类型", "default": true},
    {"name": "idx_count", "type": "int", "description": "成分个数", "default": true},
    {"name": "total_share", "type": "float", "description": "总股本(亿)", "default": true},
    {"name": "float_share", "type": "float", "description": "流通股(亿)", "default": true},
    {"name": "total_mv", "type": "float", "description": "总市值(亿)", "default": true},
    {"name": "float_mv", "type": "float", "description": "流通市值(亿)", "default": true}
  ],
  "corrections": [],
  "units": "字段描述中的单位保留原样；未注明的单位不作推断。"
}

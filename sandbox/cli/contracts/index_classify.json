  "category": "指数统计",
  "source": "https://tushare.pro/document/2?doc_id=181",
  "verified_on": "2026-11-04",
  "permission": "points",
  "row_limit": null,
  "input_schema": {
    "type": "object",
    "properties": {
      "index_code": {"type": "string", "description": "指数代码", "minLength": 1, "maxLength": 2000},
      "level": {"type": "string", "description": "行业分级（L1/L2/L3）", "minLength": 1, "maxLength": 2000},
      "parent_code": {"type": "string", "description": "父级代码（一级为0）", "minLength": 1, "maxLength": 2000},
      "src": {"type": "string", "description": "指数来源（SW2014：申万2014年版本，SW2021：申万2021年版本）", "minLength": 1, "maxLength": 2000}
    },
    "required": [],
    "additionalProperties": false
  },
  "output_fields": [
    {"name": "index_code", "type": "str", "description": "指数代码", "default": true},
    {"name": "industry_name", "type": "str", "description": "行业名称", "default": true},
    {"name": "parent_code", "type": "str", "description": "父级代码", "default": true},
    {"name": "level", "type": "str", "description": "行业层级", "default": true},
    {"name": "industry_code", "type": "str", "description": "行业代码", "default": true},
    {"name": "is_pub", "type": "str", "description": "是否发布了指数", "default": true},
    {"name": "src", "type": "str", "description": "行业分类（SW申万）", "default": false}

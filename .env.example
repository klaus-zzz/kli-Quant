# Tushare
TUSHARE_TOKEN=''
# 后端上游地址；仅填写可信的数据服务，后端会向其发送 token。
TUSHARE_BASE_URL=https://api.tushare.pro

# 研究存储仅后端读取；使用独立开发库和 bucket，禁止指向生产业务数据。
RESEARCH_DATABASE_URL=
RESEARCH_S3_ENDPOINT=
RESEARCH_S3_BUCKET=
RESEARCH_S3_ACCESS_KEY=
RESEARCH_S3_SECRET_KEY=

# 后端调用的可信抓取服务完整接口地址，可按部署服务名、端口和路径修改。
RESEARCH_FETCHER_URL=http://research-fetcher:18101/fetch

# 显式启用真实 Agent 时设为 /agent-config/.env；空值保持原开发模式。
KLI_QUANT_AGENT_ENV_FILE=
# Agent 配置仍只维护在此目录；聊天、Gateway、控制端 Token 不放入前端。
KLI_QUANT_AGENT_CONFIG_DIR=/workspace/deploy/kli-quant

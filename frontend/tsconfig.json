{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": { "@playwright/test": ["./node_modules/@playwright/test"] }
  },
  "include": ["src", "vite.config.ts", "playwright.config.cts", "../tests/e2e"]
}

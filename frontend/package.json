{
  "name": "kli-quant-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 15173 --strictPort",
    "check": "tsc --noEmit && prettier --check . ../tests/e2e",
    "format": "prettier --write . ../tests/e2e",
    "build": "tsc --noEmit && vite build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  }
}
